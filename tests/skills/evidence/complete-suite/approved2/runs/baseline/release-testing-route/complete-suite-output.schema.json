{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokoroarc.local/schemas/complete-suite-output.schema.json",
  "title": "KokoroArc complete-suite evaluator final response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "outcome",
    "response",
    "claimed_assertions",
    "created_paths",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "outcome": {
      "enum": [
        "completed",
        "blocked",
        "refused",
        "clarification_required"
      ]
    },
    "response": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "claimed_assertions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence_paths"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$"
          },
          "status": {
            "enum": ["satisfied", "not_satisfied", "not_applicable"]
          },
          "evidence_paths": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/relative_path"}
          }
        }
      }
    },
    "created_paths": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relative_path"}
    },
    "blockers": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
      "not": {"pattern": "(^|/)\\.\\.?($|/)"}
    }
  }
}

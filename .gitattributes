# Behavioral evidence contains byte offsets and must survive checkout unchanged.
tests/skills/transcripts/** -text

# Distribution inputs and release hashes require checkout-stable LF.
README.md text eol=lf
pyproject.toml text eol=lf
src/** text eol=lf
schemas/** text eol=lf

# Character sources and fixtures feed raw-byte deterministic hashes.
characters/** text eol=lf
tests/fixtures/** text eol=lf

# Skill hashes and packaged instructions must be stable across host line-ending policy.
skills/** text eol=lf
# Evaluator prompts are byte-exact captures; a terminal blank line can be evidence.
tests/skills/transcripts/authoring-character-packs/skill/*/prompt.txt whitespace=-blank-at-eof

# Research workspace manifests hash their fixture artifact bytes.
tests/fixtures/research/** text eol=lf

# Retained research campaign files are byte-exact evaluator evidence. Their raw
# Windows CRLF is valid evidence, not trailing whitespace.
tests/skills/evidence/researching-characters/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof

# Testing campaign inputs are frozen by raw SHA-256; retained evaluator evidence
# preserves its exact raw newline bytes across checkout policy.
tests/skills/testing-character-packs-* text eol=lf
tests/skills/run_testing_character_packs_campaign.py text eol=lf
tests/skills/*testing_character_packs*.py text eol=lf
tests/skills/evidence/testing-character-packs/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof

# Complete-suite approval inputs are raw-hash-bound across checkout policies.
tests/skills/complete-suite-* text eol=lf
tests/skills/*complete_suite*.py text eol=lf
docs/superpowers/plans/2026-08-20-kokoroarc-complete-suite-closure.md text eol=lf

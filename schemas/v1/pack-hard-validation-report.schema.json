{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokoroarc.local/schemas/v1/pack-hard-validation-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "created_by",
    "namespace",
    "character_id",
    "character_version",
    "mode",
    "visibility",
    "source_artifact_id",
    "source_hash",
    "compiled_artifact_id",
    "compiled_hash",
    "corpus_hash",
    "checks",
    "source_snapshot_stable",
    "deterministic",
    "passed"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_id": {"$ref": "#/$defs/artifact_id"},
    "created_by": {"$ref": "#/$defs/created_by"},
    "namespace": {"$ref": "#/$defs/slug_id"},
    "character_id": {"$ref": "#/$defs/slug_id"},
    "character_version": {"$ref": "#/$defs/semantic_version"},
    "mode": {"$ref": "#/$defs/construction_mode"},
    "visibility": {"$ref": "#/$defs/visibility"},
    "source_artifact_id": {"$ref": "#/$defs/artifact_id"},
    "source_hash": {"$ref": "#/$defs/sha256"},
    "compiled_artifact_id": {"$ref": "#/$defs/artifact_id"},
    "compiled_hash": {"$ref": "#/$defs/sha256"},
    "corpus_hash": {"$ref": "#/$defs/sha256"},
    "checks": {"$ref": "#/$defs/hard_checks"},
    "source_snapshot_stable": {"type": "boolean"},
    "deterministic": {"type": "boolean"},
    "passed": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {"enum": ["dossier", "researched", "hybrid"]}
        },
        "required": ["mode"]
      },
      "then": {"properties": {"visibility": {"const": "private"}}}
    },
    {
      "if": {
        "properties": {"passed": {"const": true}},
        "required": ["passed"]
      },
      "then": {
        "properties": {
          "source_snapshot_stable": {"const": true},
          "deterministic": {"const": true},
          "checks": {
            "properties": {
              "source_schema": {"properties": {"passed": {"const": true}}},
              "pack_layout": {"properties": {"passed": {"const": true}}},
              "provenance": {"properties": {"passed": {"const": true}}},
              "security": {"properties": {"passed": {"const": true}}},
              "compile": {"properties": {"passed": {"const": true}}},
              "fixture_structure": {"properties": {"passed": {"const": true}}},
              "locale_coverage": {"properties": {"passed": {"const": true}}},
              "protected_content": {"properties": {"passed": {"const": true}}},
              "state_replay": {"properties": {"passed": {"const": true}}}
            }
          }
        }
      },
      "else": {
        "anyOf": [
          {"properties": {"source_snapshot_stable": {"const": false}}},
          {"properties": {"deterministic": {"const": false}}},
          {"properties": {"checks": {"properties": {"source_schema": {"properties": {"passed": {"const": false}}}}}}},
          {"properties": {"checks": {"properties": {"pack_layout": {"properties": {"passed": {"const": false}}}}}}},
          {"properties": {"checks": {"properties": {"provenance": {"properties": {"passed": {"const": false}}}}}}},
          {"properties": {"checks": {"properties": {"security": {"properties": {"passed": {"const": false}}}}}}},
          {"properties": {"checks": {"properties": {"compile": {"properties": {"passed": {"const": false}}}}}}},
          {"properties": {"checks": {"properties": {"fixture_structure": {"properties": {"passed": {"const": false}}}}}}},
          {"properties": {"checks": {"properties": {"locale_coverage": {"properties": {"passed": {"const": false}}}}}}},
          {"properties": {"checks": {"properties": {"protected_content": {"properties": {"passed": {"const": false}}}}}}},
          {"properties": {"checks": {"properties": {"state_replay": {"properties": {"passed": {"const": false}}}}}}}
        ]
      }
    }
  ],
  "$defs": {
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]{0,191}(?![\\s\\S])"
    },
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": {"const": "kokoroarc"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "slug_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
      "not": {
        "enum": [
          "con", "prn", "aux", "nul",
          "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9",
          "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"
        ]
      }
    },
    "semantic_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "construction_mode": {
      "enum": ["original", "dossier", "researched", "hybrid"]
    },
    "visibility": {"enum": ["private", "public_candidate"]},
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "path", "message"],
      "properties": {
        "severity": {"enum": ["error", "warning"]},
        "code": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*(?![\\s\\S])"
        },
        "path": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._-]+(?![\\s\\S])"
              },
              {"type": "integer", "minimum": 0, "maximum": 1000000}
            ]
          }
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        }
      }
    },
    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "findings"],
      "properties": {
        "passed": {"type": "boolean"},
        "findings": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/finding"}
        }
      },
      "if": {
        "properties": {"passed": {"const": true}},
        "required": ["passed"]
      },
      "then": {
        "properties": {
          "findings": {
            "not": {
              "contains": {
                "properties": {"severity": {"const": "error"}},
                "required": ["severity"]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "findings": {
            "contains": {
              "properties": {"severity": {"const": "error"}},
              "required": ["severity"]
            }
          }
        }
      }
    },
    "hard_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_schema",
        "pack_layout",
        "provenance",
        "security",
        "compile",
        "fixture_structure",
        "locale_coverage",
        "protected_content",
        "state_replay"
      ],
      "properties": {
        "source_schema": {"$ref": "#/$defs/check_result"},
        "pack_layout": {"$ref": "#/$defs/check_result"},
        "provenance": {"$ref": "#/$defs/check_result"},
        "security": {"$ref": "#/$defs/check_result"},
        "compile": {"$ref": "#/$defs/check_result"},
        "fixture_structure": {"$ref": "#/$defs/check_result"},
        "locale_coverage": {"$ref": "#/$defs/check_result"},
        "protected_content": {"$ref": "#/$defs/check_result"},
        "state_replay": {"$ref": "#/$defs/check_result"}
      }
    }
  }
}

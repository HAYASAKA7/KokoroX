{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://kokoroarc.local/schemas/v1/research-bundle.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "created_by", "build_status", "visibility", "activation_allowed", "authoring_allowed", "identity", "scope", "request_hash", "workspace_hash", "validation_report_hash", "source_records", "claims", "conflicts", "coverage", "limitations", "blocking_reasons", "bundle_hash"],
  "properties": {"schema_version": {"const": "1.0"}, "artifact_id": {"$ref": "#/$defs/artifact_id"}, "created_by": {"$ref": "#/$defs/created_by"}, "build_status": {"const": "research"}, "visibility": {"const": "private"}, "activation_allowed": {"const": false}, "authoring_allowed": {"type": "boolean"}, "identity": {"type": "object", "additionalProperties": false, "required": ["subject_id", "franchise"], "properties": {"subject_id": {"$ref": "#/$defs/id"}, "franchise": {"type": "string", "minLength": 1, "maxLength": 256}}}, "scope": {"type": "object", "additionalProperties": false, "required": ["continuity", "timeline_cutoff", "spoiler_scope"], "properties": {"continuity": {"type": "string", "minLength": 1, "maxLength": 256}, "timeline_cutoff": {"type": "string", "minLength": 1, "maxLength": 256}, "spoiler_scope": {"type": "string", "minLength": 1, "maxLength": 512}}}, "request_hash": {"$ref": "#/$defs/sha256"}, "workspace_hash": {"$ref": "#/$defs/sha256"}, "validation_report_hash": {"$ref": "#/$defs/sha256"}, "source_records": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/record"}}, "claims": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/record"}}, "conflicts": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/record"}}, "coverage": {"$ref": "#/$defs/record"}, "limitations": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}, "blocking_reasons": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}, "bundle_hash": {"$ref": "#/$defs/sha256"}},
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!con(?:[./]|$))(?!prn(?:[./]|$))(?!aux(?:[./]|$))(?!nul(?:[./]|$))(?!com[1-9](?:[./]|$))(?!lpt[1-9](?:[./]|$))[a-z0-9][a-z0-9._-]{0,127}$"}, "artifact_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!con(?:/|$))(?!prn(?:/|$))(?!aux(?:/|$))(?!nul(?:/|$))(?!com[1-9](?:/|$))(?!lpt[1-9](?:/|$))(?!.*/(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:/|$))[a-z0-9][a-z0-9._/-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "created_by": {"type": "object", "additionalProperties": false, "required": ["component", "version"], "properties": {"component": {"const": "kokoroarc"}, "version": {"type": "string", "minLength": 1, "maxLength": 64}}}, "record": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"source_id": {"$ref": "#/$defs/id"}, "claim_id": {"$ref": "#/$defs/id"}, "conflict_id": {"$ref": "#/$defs/id"}, "artifact_id": {"$ref": "#/$defs/artifact_id"}}}}
}

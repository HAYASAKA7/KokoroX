{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokoroarc.local/schemas/v1/interaction-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "created_by",
    "event_id",
    "turn_id",
    "origin",
    "novelty_key",
    "expected_state_revision",
    "evaluator_version",
    "evidence",
    "confidence",
    "effects"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_id": {"$ref": "#/$defs/artifact_id"},
    "created_by": {"$ref": "#/$defs/created_by"},
    "event_id": {"$ref": "#/$defs/hyphen_id"},
    "turn_id": {"$ref": "#/$defs/hyphen_id"},
    "origin": {"enum": ["verified_task_outcome", "explicit_user_feedback"]},
    "novelty_key": {"$ref": "#/$defs/hyphen_id"},
    "expected_state_revision": {"type": "integer", "minimum": 0},
    "evaluator_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "evidence": {"$ref": "#/$defs/evidence"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "effects": {"$ref": "#/$defs/effects"}
  },
  "$defs": {
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$"
    },
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": {"const": "kokoroarc"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "hyphen_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": {"enum": ["test_result", "user_feedback", "tool_result", "delivery_result"]},
        "reference": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "familiarity": {"type": "number", "minimum": -4, "maximum": 4},
        "trust": {"type": "number", "minimum": -4, "maximum": 4},
        "collaboration": {"type": "number", "minimum": -4, "maximum": 4},
        "tension": {"type": "number", "minimum": -4, "maximum": 4}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokoroarc.local/schemas/v1/pack-review-attestation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "created_by",
    "review_id",
    "namespace",
    "character_id",
    "character_version",
    "mode",
    "source_artifact_id",
    "source_hash",
    "hard_report",
    "decision",
    "reviewer",
    "reviewed",
    "corrections",
    "visibility_acknowledged"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_id": {"$ref": "#/$defs/artifact_id"},
    "created_by": {"$ref": "#/$defs/created_by"},
    "review_id": {"$ref": "#/$defs/stable_id"},
    "namespace": {"$ref": "#/$defs/slug_id"},
    "character_id": {"$ref": "#/$defs/slug_id"},
    "character_version": {"$ref": "#/$defs/semantic_version"},
    "mode": {"$ref": "#/$defs/construction_mode"},
    "source_artifact_id": {"$ref": "#/$defs/artifact_id"},
    "source_hash": {"$ref": "#/$defs/sha256"},
    "hard_report": {"$ref": "#/$defs/artifact_reference"},
    "decision": {"enum": ["accept", "reject"]},
    "reviewer": {"$ref": "#/$defs/reviewer"},
    "reviewed": {"$ref": "#/$defs/review_dimensions"},
    "corrections": {"$ref": "#/$defs/corrections"},
    "visibility_acknowledged": {"const": "private"}
  },
  "if": {
    "properties": {"decision": {"const": "accept"}},
    "required": ["decision"]
  },
  "then": {
    "properties": {
      "reviewed": {
        "properties": {
          "identity": {"const": true},
          "continuity": {"const": true},
          "provenance": {"const": true},
          "overrides": {"const": true},
          "privacy": {"const": true}
        }
      },
      "corrections": {
        "additionalProperties": {
          "properties": {"disposition": {"const": "advisory"}}
        }
      }
    }
  },
  "else": {
    "anyOf": [
      {"properties": {"reviewed": {"properties": {"identity": {"const": false}}}}},
      {"properties": {"reviewed": {"properties": {"continuity": {"const": false}}}}},
      {"properties": {"reviewed": {"properties": {"provenance": {"const": false}}}}},
      {"properties": {"reviewed": {"properties": {"overrides": {"const": false}}}}},
      {"properties": {"reviewed": {"properties": {"privacy": {"const": false}}}}},
      {
        "properties": {
          "corrections": {
            "minProperties": 1,
            "additionalProperties": {
              "properties": {"disposition": {"const": "required"}}
            }
          }
        }
      }
    ]
  },
  "$defs": {
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]{0,191}(?![\\s\\S])"
    },
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": {"const": "kokoroarc"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "slug_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
      "not": {
        "enum": [
          "con", "prn", "aux", "nul",
          "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9",
          "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"
        ]
      }
    },
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*(?![\\s\\S])"
    },
    "semantic_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "construction_mode": {
      "enum": ["original", "dossier", "researched", "hybrid"]
    },
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/artifact_id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"$ref": "#/$defs/stable_id"},
        "type": {"enum": ["user", "maintainer"]}
      }
    },
    "review_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "continuity", "provenance", "overrides", "privacy"],
      "properties": {
        "identity": {"type": "boolean"},
        "continuity": {"type": "boolean"},
        "provenance": {"type": "boolean"},
        "overrides": {"type": "boolean"},
        "privacy": {"type": "boolean"}
      }
    },
    "path_segment": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+(?![\\s\\S])"
        },
        {"type": "integer", "minimum": 0, "maximum": 1000000}
      ]
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "disposition", "message"],
      "properties": {
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/path_segment"}
        },
        "disposition": {"enum": ["required", "advisory"]},
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        }
      }
    },
    "corrections": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"$ref": "#/$defs/stable_id"},
      "additionalProperties": {"$ref": "#/$defs/correction"}
    }
  }
}

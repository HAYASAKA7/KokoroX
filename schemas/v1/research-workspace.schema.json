{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://kokoroarc.local/schemas/v1/research-workspace.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "created_by", "request", "sources", "claims", "conflicts", "coverage"],
  "properties": {"schema_version": {"const": "1.0"}, "artifact_id": {"$ref": "#/$defs/artifact_id"}, "created_by": {"$ref": "#/$defs/created_by"}, "request": {"$ref": "#/$defs/request"}, "sources": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/source"}}, "claims": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/claim"}}, "conflicts": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/conflict"}}, "coverage": {"$ref": "#/$defs/coverage"}},
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "entry": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 256}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "request": {"allOf": [{"$ref": "#/$defs/entry"}, {"properties": {"path": {"const": "request.json"}}}]}, "coverage": {"allOf": [{"$ref": "#/$defs/entry"}, {"properties": {"path": {"const": "coverage.json"}}}]}, "source": {"allOf": [{"$ref": "#/$defs/entry"}, {"properties": {"path": {"pattern": "^sources/[a-z0-9][a-z0-9._-]{0,127}\\.json$"}}}]}, "claim": {"allOf": [{"$ref": "#/$defs/entry"}, {"properties": {"path": {"pattern": "^claims/[a-z0-9][a-z0-9._-]{0,127}\\.json$"}}}]}, "conflict": {"allOf": [{"$ref": "#/$defs/entry"}, {"properties": {"path": {"pattern": "^conflicts/[a-z0-9][a-z0-9._-]{0,127}\\.json$"}}}]},
    "artifact_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!con(?:/|$))(?!prn(?:/|$))(?!aux(?:/|$))(?!nul(?:/|$))(?!com[1-9](?:/|$))(?!lpt[1-9](?:/|$))(?!.*/(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:/|$))[a-z0-9][a-z0-9._/-]{0,127}$"}, "created_by": {"type": "object", "additionalProperties": false, "required": ["component", "version"], "properties": {"component": {"const": "kokoroarc"}, "version": {"type": "string", "minLength": 1, "maxLength": 64}}}
  }
}

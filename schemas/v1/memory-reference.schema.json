{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokoroarc.local/schemas/v1/memory-reference.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "created_by",
    "memory_reference_id",
    "source_kind",
    "host_memory_id",
    "scope",
    "workspace_id",
    "installation_id",
    "namespace",
    "character_id",
    "character_version",
    "archive_sha256",
    "compiled_sha256",
    "consent_id",
    "consent_revision",
    "permission",
    "summary",
    "localized_summaries",
    "content_hash",
    "embedded_content",
    "canonical_fact_authority"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_id": {"$ref": "#/$defs/artifact_id"},
    "created_by": {"$ref": "#/$defs/created_by"},
    "memory_reference_id": {"$ref": "#/$defs/stable_id"},
    "source_kind": {"const": "host_approved_reference"},
    "host_memory_id": {"$ref": "#/$defs/stable_id"},
    "scope": {"$ref": "#/$defs/scope"},
    "workspace_id": {"$ref": "#/$defs/nullable_sha256"},
    "installation_id": {"$ref": "#/$defs/stable_id"},
    "namespace": {"$ref": "#/$defs/slug_id"},
    "character_id": {"$ref": "#/$defs/slug_id"},
    "character_version": {"$ref": "#/$defs/semantic_version"},
    "archive_sha256": {"$ref": "#/$defs/sha256"},
    "compiled_sha256": {"$ref": "#/$defs/sha256"},
    "consent_id": {"$ref": "#/$defs/stable_id"},
    "consent_revision": {"type": "integer", "minimum": 1},
    "permission": {"const": "memory_references"},
    "summary": {"$ref": "#/$defs/summary"},
    "localized_summaries": {"$ref": "#/$defs/localized_summaries"},
    "content_hash": {"$ref": "#/$defs/sha256"},
    "embedded_content": {"const": false},
    "canonical_fact_authority": {"const": false}
  },
  "oneOf": [
    {
      "properties": {
        "scope": {"const": "global"},
        "workspace_id": {"type": "null"}
      }
    },
    {
      "properties": {
        "scope": {"const": "workspace"},
        "workspace_id": {"$ref": "#/$defs/sha256"}
      }
    }
  ],
  "$defs": {
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]{0,191}(?![\\s\\S])"
    },
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": {"const": "kokoroarc"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "slug_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
      "not": {
        "enum": [
          "con", "prn", "aux", "nul",
          "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9",
          "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"
        ]
      }
    },
    "semantic_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*(?![\\s\\S])"
    },
    "scope": {"enum": ["global", "workspace"]},
    "nullable_sha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^(?=.*[^\\s])[\\s\\S]+(?![\\s\\S])"
    },
    "localized_summaries": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 64,
      "patternProperties": {
        "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$": {"$ref": "#/$defs/summary"}
      }
    }
  }
}

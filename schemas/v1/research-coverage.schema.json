{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokoroarc.local/schemas/v1/research-coverage.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "created_by",
    "topics",
    "blocks_authoring"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_id": {
      "$ref": "#/$defs/artifact_id"
    },
    "created_by": {
      "$ref": "#/$defs/created_by"
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic_id",
          "status",
          "supporting_claim_ids",
          "missing_evidence",
          "unavailable_sources",
          "spoiler_restrictions",
          "blocks_authoring"
        ],
        "properties": {
          "topic_id": {
            "$ref": "#/$defs/id"
          },
          "status": {
            "enum": [
              "covered",
              "partial",
              "missing",
              "blocked"
            ]
          },
          "supporting_claim_ids": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "missing_evidence": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "unavailable_sources": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "spoiler_restrictions": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "blocks_authoring": {
            "type": "boolean"
          }
        }
      }
    },
    "blocks_authoring": {
      "type": "boolean"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!con(?:\\.|$))(?!prn(?:\\.|$))(?!aux(?:\\.|$))(?!nul(?:\\.|$))(?!com[1-9](?:\\.|$))(?!lpt[1-9](?:\\.|$))[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!con(?:\\.|/|$))(?!prn(?:\\.|/|$))(?!aux(?:\\.|/|$))(?!nul(?:\\.|/|$))(?!com[1-9](?:\\.|/|$))(?!lpt[1-9](?:\\.|/|$))(?!.*\\/(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|/|$))[a-z0-9](?:[a-z0-9._-]*[a-z0-9_-])?(?:/[a-z0-9](?:[a-z0-9._-]*[a-z0-9_-])?)*$"
    },
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "version"
      ],
      "properties": {
        "component": {
          "const": "kokoroarc"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  }
}

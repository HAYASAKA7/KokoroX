{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokoroarc.local/schemas/v1/pack-soft-evaluation-input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "created_by",
    "namespace",
    "character_id",
    "character_version",
    "mode",
    "visibility",
    "source_artifact_id",
    "source_hash",
    "compiled_artifact_id",
    "compiled_hash",
    "evaluator",
    "rubric_version",
    "fixture_version",
    "samples"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_id": {"$ref": "#/$defs/artifact_id"},
    "created_by": {"$ref": "#/$defs/created_by"},
    "namespace": {"$ref": "#/$defs/slug_id"},
    "character_id": {"$ref": "#/$defs/slug_id"},
    "character_version": {"$ref": "#/$defs/semantic_version"},
    "mode": {"$ref": "#/$defs/construction_mode"},
    "visibility": {"$ref": "#/$defs/visibility"},
    "source_artifact_id": {"$ref": "#/$defs/artifact_id"},
    "source_hash": {"$ref": "#/$defs/sha256"},
    "compiled_artifact_id": {"$ref": "#/$defs/artifact_id"},
    "compiled_hash": {"$ref": "#/$defs/sha256"},
    "evaluator": {"$ref": "#/$defs/evaluator"},
    "rubric_version": {"$ref": "#/$defs/semantic_version"},
    "fixture_version": {"$ref": "#/$defs/semantic_version"},
    "samples": {"$ref": "#/$defs/dimension_samples"}
  },
  "if": {
    "properties": {
      "mode": {"enum": ["dossier", "researched", "hybrid"]}
    },
    "required": ["mode"]
  },
  "then": {"properties": {"visibility": {"const": "private"}}},
  "$defs": {
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]{0,191}(?![\\s\\S])"
    },
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": {"const": "kokoroarc"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "slug_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
      "not": {
        "enum": [
          "con", "prn", "aux", "nul",
          "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9",
          "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"
        ]
      }
    },
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*(?![\\s\\S])"
    },
    "semantic_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "construction_mode": {
      "enum": ["original", "dossier", "researched", "hybrid"]
    },
    "visibility": {"enum": ["private", "public_candidate"]},
    "locale": {"enum": ["zh-CN", "en-US", "ja-JP"]},
    "finding_code": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*(?![\\s\\S])"
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/stable_id"},
        "version": {"$ref": "#/$defs/semantic_version"}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "scenario_id",
        "case_id",
        "score",
        "confidence",
        "finding_codes"
      ],
      "properties": {
        "locale": {"$ref": "#/$defs/locale"},
        "scenario_id": {"$ref": "#/$defs/stable_id"},
        "case_id": {"$ref": "#/$defs/stable_id"},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "finding_codes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/finding_code"}
        }
      }
    },
    "sample_group": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "propertyNames": {"$ref": "#/$defs/stable_id"},
      "additionalProperties": {"$ref": "#/$defs/sample"}
    },
    "dimension_samples": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_equivalence",
        "character_consistency",
        "locale_naturalness",
        "cross_language_persona_equivalence",
        "repetition_catchphrase_quality",
        "safety_policy_retention"
      ],
      "properties": {
        "semantic_equivalence": {"$ref": "#/$defs/sample_group"},
        "character_consistency": {"$ref": "#/$defs/sample_group"},
        "locale_naturalness": {"$ref": "#/$defs/sample_group"},
        "cross_language_persona_equivalence": {"$ref": "#/$defs/sample_group"},
        "repetition_catchphrase_quality": {"$ref": "#/$defs/sample_group"},
        "safety_policy_retention": {"$ref": "#/$defs/sample_group"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokoroarc.local/schemas/v1/persistent-character-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "created_by",
    "scope",
    "workspace_id",
    "installation",
    "consent",
    "generation_id",
    "state_contract_version",
    "transition_algorithm",
    "revision",
    "relationship",
    "mood",
    "applied_operation_ids",
    "last_event_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_id": {"$ref": "#/$defs/artifact_id"},
    "created_by": {"$ref": "#/$defs/created_by"},
    "scope": {"$ref": "#/$defs/scope"},
    "workspace_id": {"$ref": "#/$defs/nullable_sha256"},
    "installation": {"$ref": "#/$defs/installation_binding"},
    "consent": {"$ref": "#/$defs/consent_binding"},
    "generation_id": {"$ref": "#/$defs/generation_id"},
    "state_contract_version": {"const": "1.0.0"},
    "transition_algorithm": {"const": "relationship-v1"},
    "revision": {"type": "integer", "minimum": 0, "maximum": 10000},
    "relationship": {"$ref": "#/$defs/relationship"},
    "mood": {"$ref": "#/$defs/mood"},
    "applied_operation_ids": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stable_id"}
    },
    "last_event_sha256": {"$ref": "#/$defs/nullable_sha256"}
  },
  "allOf": [
    {"$ref": "#/$defs/scope_binding"},
    {
      "oneOf": [
        {
          "properties": {
            "revision": {"const": 0},
            "relationship": {
              "properties": {"revision": {"const": 0}}
            },
            "mood": {"properties": {"revision": {"const": 0}}},
            "applied_operation_ids": {"maxItems": 0},
            "last_event_sha256": {"type": "null"}
          }
        },
        {
          "properties": {
            "revision": {"type": "integer", "minimum": 1},
            "applied_operation_ids": {"minItems": 1},
            "last_event_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    }
  ],
  "$defs": {
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]{0,191}(?![\\s\\S])"
    },
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": {"const": "kokoroarc"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "slug_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
      "not": {
        "enum": [
          "con", "prn", "aux", "nul",
          "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9",
          "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"
        ]
      }
    },
    "semantic_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*(?![\\s\\S])"
    },
    "generation_id": {
      "type": "string",
      "pattern": "^generation-[a-f0-9]{32}(?![\\s\\S])"
    },
    "scope": {"enum": ["global", "workspace"]},
    "nullable_sha256": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
    },
    "scope_binding": {
      "oneOf": [
        {
          "properties": {
            "scope": {"const": "global"},
            "workspace_id": {"type": "null"}
          }
        },
        {
          "properties": {
            "scope": {"const": "workspace"},
            "workspace_id": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "installation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installation_id",
        "namespace",
        "character_id",
        "character_version",
        "archive_sha256",
        "compiled_sha256"
      ],
      "properties": {
        "installation_id": {"$ref": "#/$defs/stable_id"},
        "namespace": {"$ref": "#/$defs/slug_id"},
        "character_id": {"$ref": "#/$defs/slug_id"},
        "character_version": {"$ref": "#/$defs/semantic_version"},
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "compiled_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "consent_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consent_id", "grant_revision"],
      "properties": {
        "consent_id": {"$ref": "#/$defs/stable_id"},
        "grant_revision": {"type": "integer", "minimum": 1}
      }
    },
    "dimension_value": {"type": "number", "minimum": 0, "maximum": 100},
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["familiarity", "trust", "collaboration", "tension"],
      "properties": {
        "familiarity": {"$ref": "#/$defs/dimension_value"},
        "trust": {"$ref": "#/$defs/dimension_value"},
        "collaboration": {"$ref": "#/$defs/dimension_value"},
        "tension": {"$ref": "#/$defs/dimension_value"}
      }
    },
    "recent_novelty": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": false,
      "propertyNames": {"$ref": "#/$defs/stable_id"},
      "patternProperties": {
        "^[a-z0-9]+(?:[._-][a-z0-9]+)*(?![\\s\\S])": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_id",
        "created_by",
        "revision",
        "turn_index",
        "dimensions",
        "stage",
        "applied_event_ids",
        "recent_novelty"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "artifact_id": {"$ref": "#/$defs/artifact_id"},
        "created_by": {"$ref": "#/$defs/created_by"},
        "revision": {"type": "integer", "minimum": 0, "maximum": 10000},
        "turn_index": {"type": "integer", "minimum": 0, "maximum": 10000},
        "dimensions": {"$ref": "#/$defs/dimensions"},
        "stage": {"enum": ["unknown", "acquainted", "familiar", "trusted"]},
        "applied_event_ids": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stable_id"}
        },
        "recent_novelty": {"$ref": "#/$defs/recent_novelty"}
      },
      "oneOf": [
        {
          "properties": {
            "revision": {"const": 0},
            "turn_index": {"const": 0},
            "dimensions": {
              "properties": {
                "familiarity": {"const": 0},
                "trust": {"const": 0},
                "collaboration": {"const": 0},
                "tension": {"const": 0}
              }
            },
            "stage": {"const": "unknown"},
            "applied_event_ids": {"maxItems": 0},
            "recent_novelty": {"maxProperties": 0}
          }
        },
        {
          "properties": {
            "revision": {"type": "integer", "minimum": 1},
            "applied_event_ids": {"minItems": 1}
          }
        }
      ]
    },
    "mood_name": {
      "enum": [
        "neutral",
        "focused",
        "curious",
        "pleased",
        "amused",
        "concerned",
        "embarrassed",
        "irritated",
        "disappointed",
        "relieved",
        "proud",
        "tired"
      ]
    },
    "nullable_mood_name": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/mood_name"}]
    },
    "nullable_stable_id": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/stable_id"}]
    },
    "mood": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "primary",
        "secondary",
        "arousal",
        "valence",
        "intensity",
        "remaining_turns",
        "expires_after_turns",
        "triggering_event_id",
        "applied_event_ids"
      ],
      "properties": {
        "revision": {"type": "integer", "minimum": 0, "maximum": 10000},
        "primary": {"$ref": "#/$defs/mood_name"},
        "secondary": {"$ref": "#/$defs/nullable_mood_name"},
        "arousal": {"type": "number", "minimum": -1, "maximum": 1},
        "valence": {"type": "number", "minimum": -1, "maximum": 1},
        "intensity": {"type": "number", "minimum": 0, "maximum": 1},
        "remaining_turns": {"type": "integer", "minimum": 0, "maximum": 1000},
        "expires_after_turns": {"type": "integer", "minimum": 0, "maximum": 1000},
        "triggering_event_id": {"$ref": "#/$defs/nullable_stable_id"},
        "applied_event_ids": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stable_id"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"primary": {"const": "neutral"}}},
          "then": {
            "properties": {
              "secondary": {"type": "null"},
              "arousal": {"const": 0},
              "valence": {"const": 0},
              "intensity": {"const": 0},
              "remaining_turns": {"const": 0},
              "expires_after_turns": {"const": 0},
              "triggering_event_id": {"type": "null"}
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "revision": {"const": 0},
                "primary": {"const": "neutral"},
                "applied_event_ids": {"maxItems": 0}
              }
            },
            {
              "properties": {
                "revision": {"type": "integer", "minimum": 1},
                "applied_event_ids": {"minItems": 1}
              }
            }
          ]
        }
      ]
    }
  }
}

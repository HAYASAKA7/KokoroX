{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokoroarc.local/schemas/v1/character-build-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "created_by",
    "mode",
    "namespace",
    "character_id",
    "display_name",
    "character_version",
    "requested_locales",
    "intended_use_cases",
    "user_constraints",
    "inputs"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_id": {"$ref": "#/$defs/artifact_id"},
    "created_by": {"$ref": "#/$defs/created_by"},
    "mode": {"$ref": "#/$defs/mode"},
    "namespace": {"$ref": "#/$defs/slug_id"},
    "character_id": {"$ref": "#/$defs/slug_id"},
    "display_name": {"$ref": "#/$defs/short_string"},
    "character_version": {"$ref": "#/$defs/character_version"},
    "requested_locales": {"$ref": "#/$defs/requested_locales"},
    "intended_use_cases": {"$ref": "#/$defs/string_array"},
    "user_constraints": {"$ref": "#/$defs/string_array"},
    "continuity": {"$ref": "#/$defs/long_string"},
    "timeline": {"$ref": "#/$defs/long_string"},
    "spoiler_scope": {"$ref": "#/$defs/long_string"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/input_record"}
    },
    "requested_visibility": {
      "enum": ["private", "public"],
      "default": "private"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"mode": {"const": "original"}},
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "inputs": {
            "contains": {
              "type": "object",
              "properties": {"type": {"const": "creative_brief"}},
              "required": ["type"]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {"mode": {"const": "dossier"}},
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "inputs": {
            "contains": {
              "type": "object",
              "properties": {"type": {"const": "user_dossier"}},
              "required": ["type"]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {"mode": {"enum": ["researched", "hybrid"]}},
        "required": ["mode"]
      },
      "then": {
        "required": ["continuity", "timeline", "spoiler_scope"],
        "properties": {
          "inputs": {
            "contains": {
              "type": "object",
              "properties": {"type": {"const": "research_bundle"}},
              "required": ["type"]
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {"mode": {"const": "hybrid"}},
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "inputs": {
            "contains": {
              "type": "object",
              "properties": {
                "type": {"enum": ["user_dossier", "user_override"]}
              },
              "required": ["type"]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {"enum": ["dossier", "researched", "hybrid"]}
        },
        "required": ["mode"]
      },
      "then": {
        "properties": {"requested_visibility": {"const": "private"}}
      }
    }
  ],
  "$defs": {
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}(?![\\s\\S])"
    },
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": {"const": "kokoroarc"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "mode": {"enum": ["original", "dossier", "researched", "hybrid"]},
    "slug_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
      "not": {
        "enum": [
          "con", "prn", "aux", "nul",
          "com1", "com2", "com3", "com4", "com5",
          "com6", "com7", "com8", "com9",
          "lpt1", "lpt2", "lpt3", "lpt4", "lpt5",
          "lpt6", "lpt7", "lpt8", "lpt9"
        ]
      }
    },
    "character_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
    },
    "short_string": {"type": "string", "minLength": 1, "maxLength": 256},
    "long_string": {"type": "string", "minLength": 1, "maxLength": 4000},
    "string_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/long_string"}
    },
    "requested_locales": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "maxLength": 35, "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$"}
    },
    "input_record": {
      "oneOf": [
        {"$ref": "#/$defs/content_input_record"},
        {"$ref": "#/$defs/research_bundle_input_record"}
      ]
    },
    "content_input_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": {
          "enum": ["creative_brief", "user_dossier", "user_override"]
        },
        "content": {"type": "string", "minLength": 1, "maxLength": 262144}
      }
    },
    "research_bundle_input_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "artifact_id", "sha256"],
      "properties": {
        "type": {"const": "research_bundle"},
        "artifact_id": {"$ref": "#/$defs/artifact_id"},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    }
  }
}

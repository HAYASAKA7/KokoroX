{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokoroarc.local/schemas/v1/karc-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "created_by",
    "archive_id",
    "format_version",
    "namespace",
    "character_id",
    "character_version",
    "source_artifact_id",
    "source_hash",
    "compiled_artifact_id",
    "compiled_hash",
    "hard_validation_report",
    "soft_evaluation_report",
    "review_attestation",
    "promotion_record",
    "publication_readiness_report",
    "promotion_status",
    "visibility",
    "activation_allowed",
    "trust",
    "compatibility",
    "members"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_id": {"$ref": "#/$defs/artifact_id"},
    "created_by": {"$ref": "#/$defs/created_by"},
    "archive_id": {"$ref": "#/$defs/stable_id"},
    "format_version": {"const": "1.0.0"},
    "namespace": {"$ref": "#/$defs/slug_id"},
    "character_id": {"$ref": "#/$defs/slug_id"},
    "character_version": {"$ref": "#/$defs/semantic_version"},
    "source_artifact_id": {"$ref": "#/$defs/artifact_id"},
    "source_hash": {"$ref": "#/$defs/sha256"},
    "compiled_artifact_id": {"$ref": "#/$defs/artifact_id"},
    "compiled_hash": {"$ref": "#/$defs/sha256"},
    "hard_validation_report": {"$ref": "#/$defs/artifact_reference"},
    "soft_evaluation_report": {"$ref": "#/$defs/artifact_reference"},
    "review_attestation": {"$ref": "#/$defs/artifact_reference"},
    "promotion_record": {"$ref": "#/$defs/artifact_reference"},
    "publication_readiness_report": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/artifact_reference"}
      ]
    },
    "promotion_status": {"const": "verified"},
    "visibility": {"$ref": "#/$defs/visibility"},
    "activation_allowed": {"const": true},
    "trust": {"const": "unsigned_local"},
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "members": {
      "type": "array",
      "uniqueItems": true
    }
  },
  "oneOf": [
    {
      "properties": {
        "visibility": {"const": "private"},
        "publication_readiness_report": {"type": "null"},
        "compatibility": {
          "properties": {
            "schemas": {
              "properties": {
                "publication_readiness_report": {"type": "null"}
              }
            }
          }
        },
        "members": {
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {"$ref": "#/$defs/compiled_member"},
            {"$ref": "#/$defs/hard_member"},
            {"$ref": "#/$defs/promotion_member"},
            {"$ref": "#/$defs/review_member"},
            {"$ref": "#/$defs/soft_member"}
          ],
          "items": false
        }
      }
    },
    {
      "properties": {
        "visibility": {"const": "public_candidate"},
        "publication_readiness_report": {
          "$ref": "#/$defs/artifact_reference"
        },
        "compatibility": {
          "properties": {
            "schemas": {
              "properties": {
                "publication_readiness_report": {
                  "$ref": "#/$defs/version_range"
                }
              }
            }
          }
        },
        "members": {
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            {"$ref": "#/$defs/compiled_member"},
            {"$ref": "#/$defs/hard_member"},
            {"$ref": "#/$defs/promotion_member"},
            {"$ref": "#/$defs/publication_member"},
            {"$ref": "#/$defs/review_member"},
            {"$ref": "#/$defs/soft_member"}
          ],
          "items": false
        }
      }
    }
  ],
  "$defs": {
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]{0,191}(?![\\s\\S])"
    },
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": {"const": "kokoroarc"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "slug_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
      "not": {
        "enum": [
          "con", "prn", "aux", "nul",
          "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9",
          "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"
        ]
      }
    },
    "semantic_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*(?![\\s\\S])"
    },
    "visibility": {"enum": ["private", "public_candidate"]},
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/artifact_id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "version_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_inclusive", "maximum_exclusive"],
      "properties": {
        "minimum_inclusive": {"$ref": "#/$defs/semantic_version"},
        "maximum_exclusive": {"$ref": "#/$defs/semantic_version"}
      }
    },
    "schema_ranges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiled_pack",
        "hard_validation_report",
        "soft_evaluation_report",
        "review_attestation",
        "promotion_record",
        "publication_readiness_report"
      ],
      "properties": {
        "compiled_pack": {"$ref": "#/$defs/version_range"},
        "hard_validation_report": {"$ref": "#/$defs/version_range"},
        "soft_evaluation_report": {"$ref": "#/$defs/version_range"},
        "review_attestation": {"$ref": "#/$defs/version_range"},
        "promotion_record": {"$ref": "#/$defs/version_range"},
        "publication_readiness_report": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/version_range"}
          ]
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "schemas"],
      "properties": {
        "runtime": {"$ref": "#/$defs/version_range"},
        "schemas": {"$ref": "#/$defs/schema_ranges"}
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "size", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[a-z0-9][a-z0-9._/-]*(?![\\s\\S])"
        },
        "role": {
          "enum": [
            "compiled_pack",
            "hard_validation_report",
            "soft_evaluation_report",
            "review_attestation",
            "promotion_record",
            "publication_readiness_report"
          ]
        },
        "size": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "compiled_member": {
      "allOf": [
        {"$ref": "#/$defs/member"},
        {
          "properties": {
            "path": {"const": "pack/compiled.json"},
            "role": {"const": "compiled_pack"}
          }
        }
      ]
    },
    "hard_member": {
      "allOf": [
        {"$ref": "#/$defs/member"},
        {
          "properties": {
            "path": {"const": "release/hard-validation-report.json"},
            "role": {"const": "hard_validation_report"}
          }
        }
      ]
    },
    "promotion_member": {
      "allOf": [
        {"$ref": "#/$defs/member"},
        {
          "properties": {
            "path": {"const": "release/promotion-record.json"},
            "role": {"const": "promotion_record"}
          }
        }
      ]
    },
    "publication_member": {
      "allOf": [
        {"$ref": "#/$defs/member"},
        {
          "properties": {
            "path": {"const": "release/publication-readiness-report.json"},
            "role": {"const": "publication_readiness_report"}
          }
        }
      ]
    },
    "review_member": {
      "allOf": [
        {"$ref": "#/$defs/member"},
        {
          "properties": {
            "path": {"const": "release/review-attestation.json"},
            "role": {"const": "review_attestation"}
          }
        }
      ]
    },
    "soft_member": {
      "allOf": [
        {"$ref": "#/$defs/member"},
        {
          "properties": {
            "path": {"const": "release/soft-evaluation-report.json"},
            "role": {"const": "soft_evaluation_report"}
          }
        }
      ]
    }
  }
}
